# Reverse proxy: terminates ports 80/443 for the dashboard and all managed websites.
FROM nginx:1.31.8-alpine

RUN apk upgrade --no-cache && rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/nginx.conf
# branded fallback pages for errors nginx produces itself (generated by scripts/build-error-pages.js)
COPY errors/ /etc/nginx/errors/

EXPOSE 80 443
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8081/healthz || exit 1
