# WebManager – example configuration.
# install.sh generates the real /opt/webmanager/.env (mode 0600) with random secrets.
# Never commit a real .env file.

WM_VERSION=0.1.0
# Local build: "drimzo". For a registry use e.g. registry.example.com/drimzo
WM_IMAGE_PREFIX=drimzo

INSTALL_DIR=/opt/webmanager
DATA_DIR=/var/lib/webmanager
LOG_DIR=/var/log/webmanager
BACKUP_DIR=/var/lib/webmanager/backups

# Network exposure of the reverse proxy. Use 127.0.0.1 to keep everything local.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Optional: dashboard domain (otherwise IP-based access until you set one in the dashboard)
DASHBOARD_DOMAIN=
# Public IPs of this server for DNS diagnostics (comma separated, optional)
PUBLIC_IPS=
# Only when another reverse proxy (Cloudflare, Traefik, Pangolin ...) sits in front of WebManager: its addresses (comma separated IPs or
# CIDR ranges). Then the visitor address is taken from X-Forwarded-For, so login throttling, bans and statistics see the real visitor
# and not the proxy. Leave empty otherwise; never list addresses you do not control.
TRUSTED_PROXIES=
# Web console (website → Console tab: a shell in the website's container, administrators only). "off" removes it completely.
# CONSOLE=on
# Who may ask for console tickets: "worker" (default: a compromised dashboard, which only holds the dashboard token, cannot open
# shells in containers; the ticket takes about a second longer) or "dashboard". The console is off per website until an
# administrator switches it on, and needs two-factor authentication and a password confirmation.
# CONSOLE_TICKETS=worker
# true = Let's Encrypt staging (untrusted test certificates)
ACME_STAGING=false
# First two octets of the /16 pool used for per-website networks (/27 each)
SITE_NET_POOL=10.210
TZ=UTC

DB_NAME=webmanager
DB_USER=webmanager
DB_PASSWORD=__generated__
DB_ROOT_PASSWORD=__generated__
# 64 hex characters; encrypts environment variables stored in the database
APP_KEY=__generated__
AGENT_TOKEN_DASHBOARD=__generated__
AGENT_TOKEN_WORKER=__generated__

# Updates come from https://updates.drimzo.cc/webmanager/stable (fixed in scripts/lib.sh, not configurable).
